{
  "name": "taro",
  "version": "2.0.0-alpha.0",
  "description": "React 微信小程序（Skyline / glass-easel）现代化底座",
  "homepage": "https://github.com/specificshen/taro-lite#readme",
  "author": "Samuel Ouyang",
  "private": true,
  "license": "MIT",
  "keywords": [
    "taro",
    "react",
    "weapp",
    "skyline",
    "glass-easel"
  ],
  "bugs": {
    "url": "https://github.com/specificshen/taro-lite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specificshen/taro-lite.git"
  },
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "packages/taro-cli/tests/fixtures/default",
    "fixtures/*"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "clear-all": "bun scripts/clean.ts --node-modules",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bun scripts/typecheck.ts",
    "typecheck:fixtures": "tsc --noEmit -p fixtures/taro-lite-sunshine-lab/tsconfig.json",
    "test": "(cd packages/taro-components && bun run test) && (cd packages/taro && bun run test) && (cd packages/taro-cli && bun run test)",
    "verify:fixture:weapp": "bun run build && (cd fixtures/taro-lite-sunshine-lab && bun run build)",
    "release:check": "bun scripts/check-release-readiness.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^26.2.0",
    "bun-types": "^1.4.0",
    "typescript": "~7.0.2"
  }
}
