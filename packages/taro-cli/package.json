{
  "name": "@spcsn/taro-cli",
  "version": "2.0.0-alpha.0",
  "description": "SPCSN Taro Lite CLI for React WeApp mini programs",
  "author": "Samuel Ouyang",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test --isolate",
    "test:ci": "bun test --isolate --coverage",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "bin",
    "src",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specificshen/taro-lite.git"
  },
  "bugs": {
    "url": "https://github.com/specificshen/taro-lite/issues"
  },
  "homepage": "https://github.com/specificshen/taro-lite#readme",
  "bin": {
    "taro": "bin/taro"
  },
  "keywords": [
    "taro",
    "weapp"
  ],
  "engines": {
    "bun": ">= 1.4.0"
  },
  "dependencies": {
    "@spcsn/taro": "workspace:*",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "chalk": "^5.6.2",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-reconciler": "0.33.0",
    "sax": "1.6.0",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-reconciler": "^0.33.0",
    "@types/sax": "1.2.7"
  }
}
