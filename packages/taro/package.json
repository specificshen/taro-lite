{
  "name": "@spcsn/taro",
  "version": "2.0.0-alpha.0",
  "description": "SPCSN Taro runtime API entry",
  "author": "Samuel Ouyang",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./types/index.esm.d.ts",
        "default": "./types/index.d.ts"
      },
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./types/compile": {
      "types": "./types/compile/index.d.ts"
    },
    "./types/compile/compiler": {
      "types": "./types/compile/compiler.d.ts"
    },
    "./types/compile/config/plugin": {
      "types": "./types/compile/config/plugin.d.ts"
    },
    "./types/compile/hooks": {
      "types": "./types/compile/hooks.d.ts"
    },
    "./types/compile/viteCompilerContext": {
      "types": "./types/compile/viteCompilerContext.d.ts"
    },
    "./types/compile/vite-compiler-context": {
      "types": "./types/compile/vite-compiler-context.d.ts"
    },
    "./types/*": "./types/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "prod": "bun run build",
    "prepack": "bun run build",
    "build": "bun run clean && bun scripts/build.ts",
    "clean": "bun ../../scripts/clean.ts dist",
    "dev": "bun scripts/build.ts --watch",
    "test": "bun test",
    "test:ci": "bun test --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specificshen/taro-lite.git"
  },
  "bugs": {
    "url": "https://github.com/specificshen/taro-lite/issues"
  },
  "homepage": "https://github.com/specificshen/taro-lite#readme",
  "keywords": [
    "taro"
  ],
  "peerDependencies": {
    "@spcsn/taro-components": "^2.0.0-alpha.0",
    "@types/react": "^19",
    "react": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
